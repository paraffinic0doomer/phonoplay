{
  /* Tests, typechecked separately from application code.
     Same compiler options, plus Node's types for the built-in test runner.
     `@types/node` is already a devDependency, so this adds nothing to
     install — it only makes those types visible to test files. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    /* `vite/client` alongside Node's: the modules under test are browser code
       and reach for import.meta.env, which is Vite's. Omitting it would mean
       typechecking application source against a platform it never runs on. */
    "types": ["node", "vite/client"],
    /* DOM stays available: the modules under test (the recorder above all)
       are browser code and legitimately reference MediaRecorder, AudioContext
       and Navigator. Dropping DOM here would only mean typechecking them
       against a platform they never run on. The separation that matters is
       the other direction - app code must not see Node's types - and
       tsconfig.app.json still enforces that. */
    "lib": ["ES2023", "DOM"],
    /* Test helpers legitimately take unused parameters in callbacks. */
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*.test.ts",
    "src/language/**/*.ts",
    "src/db/**/*.ts",
    "src/lib/recorder.ts",
    "src/lib/errorCopy.ts",
    "src/onboarding/**/*.ts",
    "src/assessment/**/*.ts",
    "src/contrast/**/*.ts",
    "src/practice/**/*.ts"
  ],
  "exclude": []
}
