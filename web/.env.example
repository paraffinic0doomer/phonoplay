# Base URL for the PhonoPlay analysis service.
# Leave as /api in development — vite.config.ts proxies it to 127.0.0.1:8000.
VITE_API_BASE_URL=/api

# Temporary development fixtures (see src/lib/fixtures.ts).
# "true"  -> when the API is unreachable, fall back to scripted placeholder
#            results that are labelled in the UI. NOTHING IS ANALYSED.
# "false" -> an unreachable API surfaces as a normal error.
# Defaults to true in `npm run dev` and false in production builds.
VITE_USE_FIXTURES=true
