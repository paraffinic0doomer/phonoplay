# ── Speech-to-text (server-side only; never sent to the browser) ──────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=whisper-large-v3-turbo
GROQ_BASE_URL=https://api.groq.com/openai/v1
STT_PROVIDER=groq
STT_LANGUAGE=en

# Reliability. One retry only — the provider bills a 10-second minimum per
# request, so retrying aggressively wastes money on 1-second clips.
STT_CONNECT_TIMEOUT=5.0
STT_READ_TIMEOUT=30.0
STT_MAX_RETRIES=1
STT_RETRY_BACKOFF=0.75
STT_MAX_RETRY_DELAY=5.0

# Additional keys, tried in order after GROQ_API_KEY. Comma-separated.
GROQ_API_KEYS=
# A file of keys, one per line. Defaults to ./groq.txt and ../groq.txt when
# unset. Gitignored — never commit a key file.
GROQ_KEYS_FILE=

# ── Practice-material generation (Groq chat, not speech-to-text) ─────
# A DIFFERENT model from GROQ_MODEL above: that one is speech-to-text and
# cannot answer a chat completion at all. Verify with GET /openai/v1/models
# before changing — llama-3.3-70b-versatile returns 404 on some accounts.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_S=10.0

# ── Journey persistence ──────────────────────────────────────────────
# SQLite file holding learner progress. Never stores audio or transcripts.
JOURNEY_DB_PATH=storage/journey.db

# ── Server ───────────────────────────────────────────────────────────
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Audio ────────────────────────────────────────────────────────────
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_UPLOAD_BYTES=15728640
MIN_DURATION_S=0.2
MAX_DURATION_S=30.0
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1
